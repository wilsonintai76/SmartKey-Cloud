flowchart TB
    subgraph Hardware["🔧 ESP32 Key Cabinet"]
        ESP["ESP32 Dev Board"]
        Relay["Solenoid Relay (GPIO4)"]
        Switch["Microswitch (GPIO5)"]
        LED["Status LED (GPIO2)"]
        ESP --> Relay & Switch & LED
    end

    subgraph PWA["📱 PWA (Cloudflare Pages)"]
        Login["Login Screen"]
        Setup["First Time Setup"]
        Dashboard["Dashboard"]
        Admin["Admin Hub"]
        Login -->|"new user?"| Setup
        Setup -->|"create admin"| Login
        Login -->|"4-Digit ID + PIN"| Dashboard
        Login -->|"Fingerprint/Face ID"| Dashboard
        Dashboard --> Admin
    end

    subgraph Cloud["☁️ Cloudflare Backend"]
        Worker["Hono Worker"]
        D1[("D1 Database")]
        KV[("KV Namespace")]
        Worker --> D1 & KV
    end

    subgraph Storage["💾 Local Storage"]
        IDB[("IndexedDB (Dexie)")]
    end

    PWA <-->|"Web Bluetooth"| ESP
    PWA -->|"WebAuthn API"| Worker
    PWA -->|"Log Sync"| Worker
    PWA <-->|"Offline Buffer"| IDB

